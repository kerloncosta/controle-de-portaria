generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

generator client_custom {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model employee {
  id       String  @id(map: "pk_employee") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cpf      String  @unique @db.Char(11)
  name     String  @db.VarChar(60)
  password String  @db.VarChar(64)
  role     Decimal @db.Decimal(1, 0)
}

model Manufacturer {
  id            Int            @id @default(autoincrement())
  name          String         @db.VarChar(30)
  vehicleModels VehicleModel[] 

  @@map("manufacturer")
}

model VehicleModel {
  id              Int          @id @default(autoincrement())
  name            String       @db.VarChar(30)
  manufacturer_id Int
  manufacturer    Manufacturer @relation(fields: [manufacturer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

vehicles        Vehicle[]

  @@map("vehicle_model")
}

model Driver {
  id             String    @id @default(uuid()) @db.Uuid
  cpf            String    @unique @db.Char(11)
  name           String    @db.VarChar(60)
  cnh_expiration DateTime  @db.Date
  cnh            String    @unique @db.Char(11)

  vehicles       Vehicle[]

  @@map("driver")
}

model Vehicle {
  id        String   @id @default(uuid()) @db.Uuid
  plate     String   @unique @db.VarChar(10)
  color     String   @db.VarChar(20)
  model_id  Int
  driver_id String   @db.Uuid

  model     VehicleModel @relation(fields: [model_id], references: [id])
  driver    Driver       @relation(fields: [driver_id], references: [id])

  @@map("vehicle")
}